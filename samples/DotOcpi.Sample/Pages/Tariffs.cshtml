@page
@using System.Text.Json
@model TariffsModel
@{
    ViewData["Title"] = "Tariffs";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tariffs</h1>
        <p class="page-subtitle">@Model.Tariffs.Count pricing structures across all CPOs</p>
    </div>
</div>

<div class="page-body">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th></th>
                    <th>ID</th>
                    <th>CPO</th>
                    <th>Currency</th>
                    <th>Type</th>
                    <th>Elements</th>
                    <th>Last Updated</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Tariffs.Count; i++)
                {
                    var (cpoKey, tar) = Model.Tariffs[i];
                    var id = tar.TryGetProperty("id", out var idP) ? idP.GetString() : "—";
                    var currency = tar.TryGetProperty("currency", out var curP) ? curP.GetString() : "—";
                    var type = tar.TryGetProperty("type", out var typeP) ? typeP.GetString() : "—";
                    var elements = tar.TryGetProperty("elements", out var elP) && elP.ValueKind == JsonValueKind.Array ? elP.GetArrayLength() : 0;
                    var lastUpdated = tar.TryGetProperty("last_updated", out var luP) ? luP.GetString() : "—";

                    <tr class="expand-toggle" data-target="tar-expand-@i">
                        <td style="width:20px">▸</td>
                        <td class="mono">@id</td>
                        <td><span class="badge badge-info">@cpoKey</span></td>
                        <td class="mono">@currency</td>
                        <td class="text-sm">@type</td>
                        <td>@elements</td>
                        <td class="mono text-sm text-muted">@lastUpdated</td>
                    </tr>
                    <tr class="expand-content" id="tar-expand-@i">
                        <td colspan="7">
                            <div class="expand-inner">
                                <pre class="result-box" style="max-height: 300px; overflow: auto;">@System.Text.Json.JsonSerializer.Serialize(tar, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Tariffs.Count == 0)
                {
                    <tr><td colspan="7"><div class="empty-state"><div class="empty-state-icon">€</div><div class="empty-state-text">No tariffs synced yet.</div></div></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
